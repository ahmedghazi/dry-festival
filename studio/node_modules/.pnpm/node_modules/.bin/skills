#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/Users/ahmedghazi/Sites/dry festival/www/studio/node_modules/.pnpm/skills@1.5.22/node_modules/skills/node_modules:/Users/ahmedghazi/Sites/dry festival/www/studio/node_modules/.pnpm/skills@1.5.22/node_modules:/Users/ahmedghazi/Sites/dry festival/www/studio/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/Users/ahmedghazi/Sites/dry festival/www/studio/node_modules/.pnpm/skills@1.5.22/node_modules/skills/node_modules:/Users/ahmedghazi/Sites/dry festival/www/studio/node_modules/.pnpm/skills@1.5.22/node_modules:/Users/ahmedghazi/Sites/dry festival/www/studio/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../skills/bin/cli.mjs" "$@"
else
  exec node  "$basedir/../skills/bin/cli.mjs" "$@"
fi
